DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revory_mvp?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_CLIENT_ID="your-google-client-id"
AUTH_GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_EMAIL_FROM="REVORY <no-reply@your-domain.com>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
RESEND_TIMEOUT_MS="8000"
# Used only by the explicit `npm run email:smoke` command. Never used by the app runtime.
RESEND_SMOKE_TO=""
CRON_SECRET=""
NEXT_PUBLIC_APP_NAME=REVORY
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Keep false until the legal, security, Stripe test-mode and launch gates are signed off.
REVORY_PAID_CHECKOUT_ENABLED="false"
STRIPE_QUOTE_RECOVERY_AUDIT_PRICE_ID=""
STRIPE_STARTER_PRICE_ID=""
# Comma-separated historical Price IDs accepted only when syncing existing subscriptions.
# New checkouts always require the current canonical Price ID above.
STRIPE_STARTER_LEGACY_PRICE_IDS=""
# Dedicated hybrid Growth price. Never reuse the legacy STRIPE_GROWTH_PRICE_ID.
STRIPE_REVORY_GROWTH_MONTHLY_PRICE_ID=""
STRIPE_REVORY_GROWTH_LEGACY_PRICE_IDS=""
STRIPE_REVORY_PRO_LEGACY_PRICE_IDS=""
# Put the real key in `.env.local` or in the process environment.
# Leave blank to keep the deterministic fallback path only.
OPENAI_API_KEY=""
REVORY_LLM_ENABLED="true"
REVORY_LLM_MODEL="gpt-5-mini"
REVORY_LLM_TIMEOUT_MS="4000"
REVORY_PRODUCT_ADMIN_EMAILS=

# Protected Vercel preview only. The expected database must be a dedicated
# revory_ai_homolog_<12 hex> or revory_ai_sandbox_<12 hex> database.
REVORY_AI_SAAS_PREVIEW="false"
REVORY_AI_SAAS_SYNTHETIC_ONLY="false"
REVORY_AI_SAAS_SYNTHETIC_DATABASE=""

# Sprint 11 founder-only local read. Requires a separate OpenAI Admin API key;
# never reuse OPENAI_API_KEY for this purpose or enable this in Vercel/production.
# Bind one authorized OpenAI organization to one REVORY workspace. Do not commit
# the values below; set them only in a private local environment.
REVORY_AI_OPENAI_CONTROLLED_READ="false"
REVORY_AI_OPENAI_WORKSPACE_ID=""
REVORY_AI_OPENAI_ORG_ID=""
REVORY_AI_OPENAI_ADMIN_KEY=""

# Customer sources: local preview by default. Remote use requires the separate
# approved commercial gate documented in docs/operations/REVORY_MONITOR_399_RELEASE.md.
# Paid access and explicit owner consent are always required.
REVORY_AI_CUSTOMER_SOURCES="false"
# Local API + authorized internal ledger report preparation; requires the
# customer-source gate above. Remote synthetic preview remains unchanged.
REVORY_AI_CONNECTED_REPORTS="false"
# Server-only key version and JSON map of versions to base64 32-byte keys.
# Generate/store outside the database; retain old versions until re-encrypted.
# Do not put actual encryption keys in this example or committed files.
REVORY_AI_CONNECTION_ACTIVE_KEY=""
REVORY_AI_CONNECTION_KEYRING=""

# Recurring monitoring is off until its environment, dedicated Stripe offer,
# source permissions, operations and sandbox verification are prepared.
REVORY_AI_RECURRING_MONITOR="false"
REVORY_AI_COMMERCIAL_ENABLED="false"
REVORY_AI_COMMERCIAL_RELEASE=""
REVORY_AI_COMMERCIAL_SECURITY_REVIEWED="false"
REVORY_AI_COMMERCIAL_DATABASE=""
# Required only for the approved commercial test Preview; must match Vercel's Git ref.
REVORY_AI_COMMERCIAL_BRANCH=""
REVORY_AI_MONITOR_BILLING_MODE="test"
REVORY_AI_CUSTOMER_STRIPE_MODE="test"
REVORY_AI_MONITOR_STRIPE_KEY=""
REVORY_AI_MONITOR_PRICE_ID=""
REVORY_AI_MONITOR_WEBHOOK_SECRET=""
# Dedicated portal: cancellation + payment update, with subscription switching disabled.
REVORY_AI_MONITOR_PORTAL_CONFIGURATION_ID=""
# GitHub Actions configuration, not application runtime secrets. Keep the repo
# variable REVORY_MONITOR_DISPATCH_ENABLED=false until the approved target is ready.
# Store URL as a repository variable and secret as a repository Actions secret.
REVORY_MONITOR_DISPATCH_URL=""
REVORY_MONITOR_DISPATCH_SECRET=""
